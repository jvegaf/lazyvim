{
  "if_command_exists": {
    "prefix": "if_command_exists",
    "description": "if command exists...",
    "body": [
      "if builtin command -v $1 > /dev/null 2>&1; then",
      "\t$2",
      "fi"
    ]
  },
  "start_shellscript": {
    "prefix": "start_shellscript",
    "description": "create new shellscript",
    "body": [
      "#!/bin/bin/env bash",
      "set -ue",
      "set -o pipefail",
      "",
      "$1"
    ]
  },
  "script_path": {
    "prefix": "script_path",
    "description": "get script path",
    "body": [
      "script_dir=$(cd $(dirname $0) >/dev/null 2>&1 && pwd)"
    ]
  },
  "exists_variable_posix": {
    "prefix": "exists_variable_posix",
    "description": "check the variable exists",
    "body": [
      "if [ -n \"${${1}+1}\" ]; then",
      "\t$2",
      "fi"
    ]
  },
  "exists_variable_zsh": {
    "prefix": "exists_variable_zsh",
    "description": "check the variable exists",
    "body": [
      "if (( ${+${1}} ));",
      "\t$2",
      "fi"
    ]
  },
  "exists_variable_zsh_5_3": {
    "prefix": "exists_variable_zsh_5_3",
    "description": "check the variable exists",
    "body": [
      "if [[ -v $1 ]]; then",
      "\t$2",
      "fi"
    ]
  },
  "shebang": {
    "prefix": "#!/usr/bin/env",
    "body": [
      "#!/usr/bin/env ${1:sh}",
      "#",
      "# ${2:Description of the script.}$0"
    ],
    "description": [
      "Shebang to specify what shell is going to run the script by default. It includes a description of the script. \n\nIt must be defined in the first line of the script.\n\nBy using #!/usr/bin/env we are making the shebang portable, meaning it is going to work correctly even if the interpreter is not located under /usr/bin"
    ]
  }
}
